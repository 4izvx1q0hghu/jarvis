# Copy to .env and fill in what you need. Never commit .env.

# --- The brain (one is enough) ---------------------------------------------
# Free: aistudio.google.com → Get API key (AQ… or AIza…)
GEMINI_API_KEY=
# Paid: console.anthropic.com → API keys (sk-ant-…)
ANTHROPIC_API_KEY=
# gemini | anthropic   (default: whichever key is set)
# JARVIS_PROVIDER=gemini
# JARVIS_MODEL=

# --- Access ---------------------------------------------------------------
# Leave empty to get a fresh random token each start (printed in the console).
# JARVIS_TOKEN=
# 127.0.0.1 = this computer only. 0.0.0.0 = your network (then use the token!)
# JARVIS_HOST=127.0.0.1
# JARVIS_PORT=8787
# Extra browser origins allowed without a token, comma-separated
# JARVIS_ALLOWED_ORIGINS=

# --- Files: the ONLY folders JARVIS may read and change (comma-separated) ---
# JARVIS_ALLOWED_DIRS=C:\Users\you\Documents\JARVIS,C:\Users\you\Downloads

# --- Apps JARVIS may open, beyond the built-in list -------------------------
# JARVIS_APPS=obs=C:\Program Files\obs-studio\bin\64bit\obs64.exe;discord=C:\Users\you\AppData\Local\Discord\Update.exe

# --- Voice ------------------------------------------------------------------
# JARVIS_WAKE_WORD=hey_jarvis
# Any voice from `edge-tts --list-voices`. Warm, friendly American female voices:
# en-US-AvaNeural (default), en-US-AriaNeural, en-US-JennyNeural, en-US-EmmaNeural.
# Male British butler: en-GB-RyanNeural
# JARVIS_VOICE=en-US-AvaNeural
# JARVIS_WHISPER=base.en

# --- Senses: off unless you switch them on -----------------------------------
# JARVIS_CAMERA=1
# JARVIS_SCREEN=1

# --- Weather on the dashboard (your city's coordinates) ----------------------
# JARVIS_LAT=6.9271
# JARVIS_LON=79.8612

# --- Smart home (Home Assistant → Profile → Long-lived access tokens) -------
# HOME_ASSISTANT_URL=http://homeassistant.local:8123
# HOME_ASSISTANT_TOKEN=

# --- Email (use an app password, never your main password) ------------------
# SMTP_HOST=smtp.gmail.com:587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=

# --- Permissions --------------------------------------------------------------
# Tools that never ask first (careful), and tools that never run
# JARVIS_AUTO_APPROVE=write_file
# JARVIS_DENY=send_email,delete_file
# JARVIS_MAX_STEPS=8

# --- Memory encryption at rest (pip install cryptography; generate with:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# JARVIS_MEMORY_KEY=
